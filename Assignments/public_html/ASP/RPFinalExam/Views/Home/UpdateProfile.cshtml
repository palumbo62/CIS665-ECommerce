@model UserInfo

@{
    ViewData["Title"] = "Update Profile";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}

<h1>Update Profile</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="UpdateProfile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserPk" />
            <div class="form-group">
                <label asp-for="UserFirstName" class="control-label">First Name</label>
                <input asp-for="UserFirstName" class="form-control" />
                <span asp-validation-for="UserFirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserLastName" class="control-label">Last Name</label>
                <input asp-for="UserLastName" class="form-control" />
                <span asp-validation-for="UserLastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserLoginName" class="control-label">Login Name</label>
                <input asp-for="UserLoginName" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="UserLoginPassword" class="control-label">Login Password</label>
                <input asp-for="UserLoginPassword" class="form-control" readonly />
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
            @if (Context.User.Identity.IsAuthenticated)
            {
                <div>
                    <a asp-action="Logout" class="btn btn-secondary">Logout</a>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
