<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    @*This is how you pass in a different title for each page - use the ViewBag*@ 
    <title>@ViewBag.Title</title>

    <style>
        #mainDiv {
            padding: 20px;
            border: solid medium black;
            font-size: 20pt;
        }
    </style>
</head>
<body>
    <h1>Ram Technology</h1>
    <div id="mainDiv">
        @RenderBody()
    </div>
</body>
</html>
