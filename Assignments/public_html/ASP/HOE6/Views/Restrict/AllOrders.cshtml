@model IEnumerable<LoginInfo>

@{
    ViewData["Title"] = "All Orders";
}

<h1>Tara Store - Orders</h1>

@foreach (var cust in Model)
{
    @* Boot strap card class*@
    <div class="card">
        <h3>@cust.FullName</h3>
        <div class="card-body">
            @foreach (var order in cust.TblOrder)
            {
                <h4 class="card-title">@($"{order.OrderDate:d}")</h4>

                <table class="table table-sm table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="70%">Product</th>
                            <th width="15%" class="text-right">Price</th>
                            <th width="15%" class="text-right">Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in order.TblOrderDetail)
                        {
                            <tr>
                                <td>@detail.ProductFkNavigation.ModelName</td>
                                <td class="text-right">@detail.ProductFkNavigation.UnitCost.ToString("c")</td>
                                <td class="text-right">@detail.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

