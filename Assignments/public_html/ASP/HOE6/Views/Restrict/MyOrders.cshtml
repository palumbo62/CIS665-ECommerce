@model IEnumerable<TblOrderDetail>

@{
    ViewData["Title"] = "My Orders";
}
@* Check to see if any orders are in the received model *@
@if (Model.Any())
{
    <h1>Orders for @Context.User.Identity.Name</h1>

    <table class="table table-sm table-striped table-bordered">
        <thead>
            <tr>
                <th>Order Date</th>
                <th>Product</th>
                <th class="text-right">Price</th>
                <th class="text-right">Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                @*OrderDate in the DB can be null so use '?'*@
                <td>@($"{item.OrderFkNavigation?.OrderDate:d}")</td>
                <td>@item.ProductFkNavigation.ModelName</td>
                <td class="text-right">@item.ProductFkNavigation.UnitCost.ToString("c")</td>
                <td class="text-right">@item.Quantity</td>
            </tr>
            }
        </tbody>
    </table>

}
else
{
    <h1>No orders for @Context.User.Identity.Name</h1>
}

