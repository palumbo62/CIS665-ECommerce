@model HandsOnEx4.Models.Product

@{
    ViewData["Title"] = "Delete";
}

<h1>Tara Store - Delete Product</h1>

<h3>Are you sure you want to delete this product?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
        <dt class="col-sm-2">
            @*@Html.DisplayNameFor(model => model.ModelName)*@
            Product
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ModelName)
        </dd>
        <dt class="col-sm-2">
            @*@Html.DisplayNameFor(model => model.ProductImage)*@
            Image
        </dt>
        <dd class="col-sm-10">
            @*@Html.DisplayFor(model => model.ProductImage)*@
            <img src="https://cisweb.biz.colostate.edu/leov/aspcore/images/productpics/@Model.ProductImage"
                 height="100" width="100" alt="@Model.ProductImage" />
        </dd>
        <dt class="col-sm-2">
            @*@Html.DisplayNameFor(model => model.UnitCost)*@
            Price
        </dt>
        <dd class="col-sm-10">
            @*@Html.DisplayFor(model => model.UnitCost)*@
            @Model.UnitCost.ToString("c")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        @*<dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Thumbnail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Thumbnail)
        </dd>*@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Availability)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Availability)
        </dd>
        <dt class="col-sm-2">
            @*@Html.DisplayNameFor(model => model.CategoryFkNavigation)*@
            Category
        </dt>
        <dd class="col-sm-10">
            @*@Html.DisplayFor(model => model.CategoryFkNavigation.CategoryImage)*@
            @Html.DisplayFor(model => model.CategoryFkNavigation.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @*@Html.DisplayNameFor(model => model.SubCategoryFkNavigation)*@
            Subcategory
        </dt>
        <dd class="col-sm-10">
            @*@Html.DisplayFor(model => model.SubCategoryFkNavigation.Description)*@
            @Html.DisplayFor(model => model.SubCategoryFkNavigation.SubCategoryName)
        </dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ProductPk" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancel - Back to Product List</a>
    </form>
</div>
