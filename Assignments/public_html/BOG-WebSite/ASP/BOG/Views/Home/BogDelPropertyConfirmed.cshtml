@model PropertyT

@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Delete Property";
}

<!DOCTYPE html>

<html>
<partial name="_BogHeaderView" />
<body>
    <section id="bannerList">
        <h2>Property listing 'ID=@Model.PropertyIdPk' has been successfully deleted!</h2>
    </section>

    @*Razor block example*@
    <section id="secondbannerList" style="padding: 5em 0 5em">
        <form>
            <ul class="article-list-vertical-Select">
                <li>
                    <p>
                        <br />Property ID:&nbsp; @Model.PropertyIdPk
                        <br />Property Type:&nbsp; @Model.PropertyTypeIdFkNavigation.PropertyTypeName
                        <br />Location:&nbsp; @Model.Address &nbsp; @Model.City &nbsp; @Model.State &nbsp; @Model.Zipcode
                        <br />

                        <img src="~/images/@Model.ImageName" alt="Property @Model.PropertyIdPk" />
                    </p>

                    <hr />
                    <a asp-action="BogDelProperty" class="btn btn-sm btn-primary">Delete Another?</a>
                    <a asp-action="BogHome" class="btn btn-sm btn-info">Home Page</a>
                </li>
            </ul>
        </form>
    </section>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>
