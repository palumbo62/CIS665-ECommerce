@model IEnumerable<BOG.Models.CommentsT>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateSubmitted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MonthYearVisit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comments)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PropertyIdFkNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdFkNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateSubmitted)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MonthYearVisit)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Comments)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyIdFkNavigation.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserIdFkNavigation.Address)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CommentIdPk">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CommentIdPk">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CommentIdPk">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
