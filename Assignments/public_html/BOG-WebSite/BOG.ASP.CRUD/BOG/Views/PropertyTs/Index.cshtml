@model IEnumerable<BOG.Models.PropertyT>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PropertyTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.State)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zipcode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DailyPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumBedrooms)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumBathrooms)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SqFt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GuestCnt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pic)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PropertyTypeIdFkNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.State)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Zipcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DailyPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumBedrooms)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumBathrooms)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SqFt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GuestCnt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pic)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyTypeIdFkNavigation.PropertyTypeIdPk)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PropertyIdPk">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PropertyIdPk">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PropertyIdPk">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
