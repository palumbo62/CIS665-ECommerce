@model PropertyT

@{
    Layout = null;
    //ViewData["Title"] = ViewBag.Title;
    //ViewData["PageTitle"] = $"BeOurGuest - Reservation for {Model.PropertyIdPk}";
    ViewData["PageTitle"] = $"BeOurGuest - Reservation for Property ID [NEED TO USE REAL ID HERE]";
}

<!DOCTYPE html>

<html>
<body>
    <partial name="_BogHeaderView" />

    <!-- Banner -->
    <section id="bannerList">
        <h2>Reservations</h2>
    </section>

    <form asp-action="BogSelectedProperty" method="post">
        <section id="bannerBlue">
            <table class="blueTable">
                <thead>
                    <tr>
                        <th>PropertyID</th>
                        <th>CheckIn-Date</th>
                        <th>CheckOut-Date</th>
                        <th>Address</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Zipcode</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>DISPLAY PROPTY RESERVATIONS HERE</td>
                    </tr>
                </tbody>
            </table>
            <br>
            <button class="btn btn-primary" type="submit">Return</button>
        </section>
    </form>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>
