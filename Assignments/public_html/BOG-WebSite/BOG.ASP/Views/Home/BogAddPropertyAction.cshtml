@model PropertyT;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thanks</title>
</head>
<body style="font-size: large">
    <h1>Property has been added. @Model.</h1>

    @*Razor block example*@

    <p>

        @*Embedded C#*@
        @if (true)
        {
            @: @Model.PropertyTypeIdFk
            @: @Model.Address
            @: @Model.City
            @: @Model.State
            @: @Model.Zipcode
            @: @Model.DailyPrice.ToString("c")
            @: @Model.NumBedrooms
            @: @Model.NumBathrooms
            @: @Model.GuestCnt
            @: @Model.SqFt
            @: @Model.ImageName
        }

        @*Asp-action to show a new View*@

        <br /><br />
        Click <a asp-action="BogAddProperty">here</a> to add another another property.

    </p>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>
