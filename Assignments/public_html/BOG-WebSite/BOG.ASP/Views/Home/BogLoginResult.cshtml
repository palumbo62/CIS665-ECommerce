@model BogLoginCreds;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
</head>
<body style="font-size: large">
    @*Razor block example*@

    <p>
        @*Embedded C#*@
        @if (Model.valid())
        {
            @: Login was successful! You will now be redirected to the home page.
        }
        else
        {
            @: Login was not successful.  Please try again.
        }

        <br /><br />
        Click <a asp-action="Register">here</a> to add another user.

    </p>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>
