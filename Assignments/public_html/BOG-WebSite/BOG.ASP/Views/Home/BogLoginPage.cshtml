@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Log In Page";
}

<!DOCTYPE html>

<html>
<body style="font-size:12pt">
    <partial name="_BogHeaderView" />

    <section id="bannerList">
        <h2>Login</h2>
    </section>

    <section id="banner">
        <form asp-action="BogLoginPage" method="post" class="p-3">
            <div class="containerLogin">
                <input type="hidden" name="redirect" value="<?php echo $redirect?>" /><br>

                <input type="text" placeholder="EmailAddress" name="email" required
                       maxlength="50"
                       autofocus="autofocus"
                       title="Enter email address"><br>

                <input type="password" placeholder="Password" name="password" required
                       maxlength="20"
                       autofocus="autofocus"
                       title="Enter password"><br>

                <!--Button Should reach out to php page and confirm user or admin access-->
                <br>
                <button class="btn btn-primary" type="submit">Login</button>
                <button class="btn btn-primary" type="reset">Reset</button>
                @*<button name="userLogin" type="submit" value="login">Login</button>*@
                @*<button name="userReset" type="reset" value="reset">Reset</button>*@
                <button class="btn btn-primary" asp-action="BogHome">Cancel</button>
                @*<button type="button" onclick="location.href='BogHome.php';return false;">Cancel</button>*@

                <!--<button type="submit" value="Login" name="login">Login</button>-->
                <p>
                    <a asp-action="BogRegister" style="text-underline-position:auto">Register for Account</a>
                </p>
            </div>
        </form>
    </section>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>
