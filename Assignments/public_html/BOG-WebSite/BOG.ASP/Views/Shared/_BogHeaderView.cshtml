@{
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>BeOurGuest - Vacation Rentals</title>
    <link rel="stylesheet" type="text/css" href="~/css/BOG_Style_Layout_All.css">
    <link rel="stylesheet" href="../fonts/css/font-awesome.css">

    <style>
        .navbar a:hover, .dropdown:hover .dropbtn {
            background-color: deepskyblue;
        }

        .dropdown {
            position: relative;
            display: block;
        }

            .dropdown .dropbtn {
                font-size: inherit;
                border: none;
                outline: none;
                color: white;
                padding: 14px 16px;
                background-color: inherit;
                font-family: inherit;
                margin: 0;
            }

        .dropbtn {
            font-size: inherit;
            border: none;
            outline: none;
            color: white;
            padding: 14px 16px;
            background-color: inherit;
            font-family: inherit;
            margin: 0;
        }

        .dropdown-content {
            display: none;
            width: 100%;
            position: absolute;
            background-color: #383b43;
            margin: 0;
            padding: 0;
            min-width: 160px;
            line-height: 1.75em;
            box-shadow: none;
        }

            .dropdown-content a {
                margin: 0;
                width: 100%;
                border: solid;
                background-color: inherit;
                border-width: thin;
            }

        .dropdown:hover .dropdown-content {
            display: inline-block;
        }
    </style>
</head>

<div>
    <!-- Header -->
    <header id="header">
        <h1>
            @ViewData["PageTitle"]
        </h1>
        <nav id="nav">
            @*<div>
                @if (Context.Session.GetInt32("UserLoggedIn") == 1)
                {
                    @: User Is LOGGED IN
                }
                @if (Context.Session.GetInt32("UserRoleType") == 1)
                {
                    @: User Is ADMIN
                }
                else if (Context.Session.GetInt32("UserRoleType") == 2)
                {
                    @: User Is REGISTER USER
                }
                else
                {
                    @: User is BROWSING
                }
            </div>*@
            <ul>
                <li>
                    <a asp-action="index">Home</a>
                </li>
                <li>
                    <a asp-action="BogProperties">Properties</a>
                </li>

                @if (Context.Session.GetInt32("UserLoggedIn") == 1)
                {
                    if (Context.Session.GetInt32("UserRoleType") == 1)
                    {
                        // Admin
                        <li>
                            <div class="dropdown">
                                <button class="dropbtn">Admin<i class="fa fa-caret-down"></i></button>
                                <div class="dropdown-content">
                                    <a asp-action="BogAddProperty">Add Property</a>
                                    <a asp-action="BogDelProperty">Delete Property</a>
                                </div>
                            </div>
                        </li>
                    }
                    else if (Context.Session.GetInt32("UserRoleType") == 2)
                    {
                        // Registered User
                        <li>
                            <a asp-action="BogUserProfile">Account</a>
                        </li>
                    }

                    <li>
                        <a asp-action="BogLogout">Logout</a>
                    </li>
                }
                else
                {
                    <li>
                        <a asp-action="BogLoginPage">Login/Register</a>
                    </li>
                }

                <li>
                    <a asp-action="BogAbout">About</a>
                </li>

            </ul>
        </nav>
    </header>
</div>
