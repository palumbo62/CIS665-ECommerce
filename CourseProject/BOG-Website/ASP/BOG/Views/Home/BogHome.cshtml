@{
    Layout = null;

    if (TempData["message"] != null)
    {
        ViewData["PageTitle"] = TempData["message"];
        TempData["message"] = null;
    }
    else if (ViewData["PageTitle"] == null)
    {
        ViewData["PageTitle"] = "Welcome to BeOurGuest! Take your time and browse our properties!";
    }

    var propSearchModel = ViewData["PropSearchModel"] as BogHomeSearch;
}

<!DOCTYPE html>

<html>
    <partial name="_BogHeaderView" />
    <body>
        <section id="bannerHome" style="padding: 8em 0 22em">
            <!-- Home Page Custom Banner-->
            <h2>BeOurGuest</h2>
            <p>
                It's time to enjoy our wide range of vacation homes from city townhomes, <br />
                country cabins, luxury family homes, and even ocean front condos. <br />
                Your next getaway is waiting on you!<br />
            </p>
            <p>Book your perfect vacation home today! </p><br>

            <!----------Search form inside banner ----------- -->
            <div class="SearchState">
                <form asp-action="BogHomeSearch" method="get">
                    <partial name="_BogPropertySearchView" />

                    <button type="submit" class="btn btn-lg btn-success fa fa-search"></button>
                    @*<button type="reset" class="btn btn-sm btn-info">Reset</button>*@
                </form>
            </div>
        </section>

        <!-- Display the page footer -->
        <partial name="_BogFooterView" />
    </body>
</html>
