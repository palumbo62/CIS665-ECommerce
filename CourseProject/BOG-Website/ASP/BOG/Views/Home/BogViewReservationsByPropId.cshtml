@model IEnumerable<ReservationT>

@{
    Layout = null;

    ViewData["PageTitle"] = $"BeOurGuest - Reservations";

    var property = Model.First();
    var propId = TempData["ReturnPropId"];
    var returnAction = TempData["ReturnAction"];
}

<!DOCTYPE html>

<html>
    <partial name="_BogHeaderView" />
    <body>

        <!-- Banner -->
        <section id="bannerList">
            <h2>Upcoming Reservations for Property @propId</h2>
        </section>

        <section id="bannerBlue">
            <table class="blueTable" align="center">
                <thead>
                    <tr>
                        <th height="50px" colspan="3" style="color:darkred; font-size:x-large">
                            Property Address: &nbsp;&nbsp;
                            @property.PropertyIdFkNavigation.Address
                            @property.PropertyIdFkNavigation.City
                            @property.PropertyIdFkNavigation.State
                            @property.PropertyIdFkNavigation.Zipcode
                        </th>
                    </tr>
                    <tr>
                        <th>CheckIn-Date</th>
                        <th>CheckOut-Date</th>
                        <th>Total-Days</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                @r.CheckIn.Date.ToString("MM/dd/yyyy")
                            </td>
                            <td>
                                @r.CheckOut.Date.ToString("MM/dd/yyyy")
                            </td>
                            <td>
                                @(r.CheckOut.Date.Subtract(r.CheckIn.Date).TotalDays + 1)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br />
                <a asp-action="@returnAction" asp-route-propId="@propId" class="btn btn-sm btn-primary">Return</a>
            <br /><br />
        </section>

        <!-- Display the page footer -->
        <partial name="_BogFooterView" />
    </body>
</html>
