@model PropertyT

@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Add Property";

    var propTypeList = ViewData["PropTypeList"] as IEnumerable<SelectListItem>;
    var ptList = ViewBag.PropTypeList as IEnumerable<SelectListItem>;
}

<!DOCTYPE html>

<html>
    <partial name="_BogHeaderView" />
    <body>

        <section id="bannerList">
            <h2>Enter Property Details</h2>
        </section>

        <section id="banner" style="padding: 2em 0 4em">
            <form asp-action="BogAddPropertyAction" method='post' enctype="multipart/form-data">
                <div class="containerAddProp">
                    <p>
                        <!--dynamic menu option for property type-->
                        <label class="BogLabel">Property Type: </label>
                        @Html.DropDownListFor(p => p.PropertyTypeIdFk, propTypeList, "Select")
                    </p>

                    <!----- Listing Title -------------------------------------------------->
                    <p>
                        <label class="BogLabel" asp-for="PropertyTitle">Listing Title:</label>
                        <input class="BogInput" type="text" asp-for="PropertyTitle" required
                               maxlength="50"
                               size="50"
                               pattern="^[a-zA-Z '!?.]{1,50}$"
                               title="Enter listing title">
                    </p>

                    <!----- Address -------------------------------------------------------->
                    <p>
                        <label class="BogLabel" asp-for="Address">Address:</label>
                        <input class="BogInput" type="text" asp-for="Address" required
                               maxlength="50"
                               size="50"
                               pattern="^[a-zA-Z0-9 '.]{1,30}$"
                               title="Enter listing address">
                    </p>

                    <!----- City ---------------------------------------------------------->
                    <p>
                        <label class="BogLabel" asp-for="City">City:</label>
                        <input class="BogInput" type="text" asp-for="City" required
                               maxlength="30"
                               size="30"
                               pattern="^[a-zA-Z '.]+$"
                               title="Enter listing city">
                    </p>

                    <!----- State ---------------------------------------------------------->
                    <p>
                        <label class="BogLabel" asp-for="State">State:</label>
                        <select class="BogInput" id="state" asp-for="State"
                                title="Select state">
                            <option value="" disabled selected="">Select listing state</option>
                            <option value="AL">Alabama</option>
                            <option value="AK">Alaska</option>
                            <option value="AZ">Arizona</option>
                            <option value="AR">Arkansas</option>
                            <option value="CA">California</option>
                            <option value="CO">Colorado</option>
                            <option value="CT">Connecticut</option>
                            <option value="DE">Delaware</option>
                            <option value="DC">District Of Columbia</option>
                            <option value="FL">Florida</option>
                            <option value="GA">Georgia</option>
                            <option value="HI">Hawaii</option>
                            <option value="ID">Idaho</option>
                            <option value="IL">Illinois</option>
                            <option value="IN">Indiana</option>
                            <option value="IA">Iowa</option>
                            <option value="KS">Kansas</option>
                            <option value="KY">Kentucky</option>
                            <option value="LA">Louisiana</option>
                            <option value="ME">Maine</option>
                            <option value="MD">Maryland</option>
                            <option value="MA">Massachusetts</option>
                            <option value="MI">Michigan</option>
                            <option value="MN">Minnesota</option>
                            <option value="MS">Mississippi</option>
                            <option value="MO">Missouri</option>
                            <option value="MT">Montana</option>
                            <option value="NE">Nebraska</option>
                            <option value="NV">Nevada</option>
                            <option value="NH">New Hampshire</option>
                            <option value="NJ">New Jersey</option>
                            <option value="NM">New Mexico</option>
                            <option value="NY">New York</option>
                            <option value="NC">North Carolina</option>
                            <option value="ND">North Dakota</option>
                            <option value="OH">Ohio</option>
                            <option value="OK">Oklahoma</option>
                            <option value="OR">Oregon</option>
                            <option value="PA">Pennsylvania</option>
                            <option value="RI">Rhode Island</option>
                            <option value="SC">South Carolina</option>
                            <option value="SD">South Dakota</option>
                            <option value="TN">Tennessee</option>
                            <option value="TX">Texas</option>
                            <option value="UT">Utah</option>
                            <option value="VT">Vermont</option>
                            <option value="VA">Virginia</option>
                            <option value="WA">Washington</option>
                            <option value="WV">West Virginia</option>
                            <option value="WI">Wisconsin</option>
                            <option value="WY">Wyoming</option>
                        </select>
                    </p>

                    <!----- ZIP Code ---------------------------------------------------------->
                    <p>
                        <label class="BogLabel" asp-for="Zipcode">Zipcode:</label>
                        <input class="BogInput" type="text" asp-for="Zipcode" required
                               maxlength="5"
                               size="5"
                               pattern="^[0-9]{5}$"
                               title="Enter 5-digit zipcode">
                    </p>

                    <hr>

                    <p>
                        <label class="BogLabel" asp-for="DailyPrice">Daily Price: $</label>
                        <input class="BogInput" type="number" asp-for="DailyPrice" id="price" required
                               maxlength="8"
                               size="8"
                               min="0.01" step="0.01" max="99999.99"
                               style="width: 8em"
                               pattern="^[(\d{3})([\.])(\d{2})]{8}$"
                               title="Enter daily rental price" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="NumBedrooms">Bedrooms:&nbsp;</label>
                        <input class="BogInput" type="number" asp-for="NumBedrooms" id="numbeds" required
                               maxlength="3"
                               size="3"
                               min="0" max="50"
                               style="width: 5em"
                               pattern="^[(0-9)]{3}$"
                               title="Enter number of bedrooms" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="NumBathrooms">Bathrooms:&nbsp;</label>
                        <input class="BogInput" type="number" asp-for="NumBathrooms" id="numbaths" required
                               maxlength="3"
                               size="3"
                               min="0" max="50"
                               pattern="^[(0-9)]{3}$"
                               style="width: 5em"
                               title="Enter number of bathrooms" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="GuestCnt">Sleeps:&nbsp;</label>
                        <input class="BogInput" type="number" asp-for="GuestCnt" id="guestcnt" required
                               maxlength="3"
                               size="3"
                               min="0" max="50"
                               pattern="^[(0-9)]{3}$"
                               style="width: 5em"
                               title="Enter maximum number of guests" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="SqFt">Square Footage:&nbsp;</label>
                        <input class="BogInput" type="number" asp-for="SqFt" id="sqft"
                               value="0"
                               maxlength="5"
                               size="5"
                               min="0" max="10000"
                               pattern="^[(0-9)]{5}$"
                               style="width: 5em"
                               title="Enter square footage of property" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="Description">Description:&nbsp;</label>
                        <textarea class="BogInput" asp-for="Description" rows="3" cols="50"
                                  pattern="^[a-zA-Z0-9 '!?.]{1,250}$"
                                  value=""
                                  title="Enter a description for this listing"></textarea>
                    </p>

                    <hr />
                    <!--Button Should reach out to php page and confirm user or admin access-->
                    <button name="propAdd" class="btn btn-sm btn-success" type="submit" value="add">Add</button>
                    <a asp-action="BogHome" class="btn btn-sm btn-info">Cancel</a>
                </div>
            </form>
        </section>

        <!-- Display the page footer -->
        <partial name="_BogFooterView" />

    </body>
</html>
