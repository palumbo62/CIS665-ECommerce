@model BogPassword

@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Change Password";
}

<!DOCTYPE html>

<html>
    <partial name="_BogHeaderView" />
    <body>
         <section id="bannerList">
            <h2>Enter your new password credentials</h2>
            <br />
        </section>

        @*<section id="banner">*@
        <section id="banner" style="padding: 5em 0 22em">
            <form asp-action="BogChangePasswordValidate" method="post" class="p-3">
                <div class="containerAddProp">
                    <p>
                        <label class="BogLabel" asp-for="CurrPassword">Current Password</label>
                        <input class="BogInput" type="password" asp-for="CurrPassword" required
                               maxlength="20"
                               size="20"
                               title="Enter your current password">
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="NewPassword">New Password</label>
                        <input class="BogInput" type="text" asp-for="NewPassword" required
                               pattern="^[a-zA-Z0-9 .!$]{4,20}$"
                               maxlength="20"
                               size="20"
                               title="Must be 4-20 in length using alpha-numeric and the set of [ !.$] characters" />
                    </p>

                    <p>
                        <label class="BogLabel" asp-for="ConfPassword">Confirm New Password</label>
                        <input class="BogInput" type="text" asp-for="ConfPassword" required
                               pattern="^[a-zA-Z0-9 .!$]{4,20}$"
                               maxlength="20"
                               size="20"
                               title="Must be 4-20 in length using alpha-numeric and the set of [ !.$] characters" />
                    </p>


                    <!--Button Should reach out to php page and confirm user or admin access-->
                    <br>
                    <button class="btn btn-sm btn-success" type="submit">Change Password</button>
                    <a  asp-action="BogUserProfile" class="btn btn-sm btn-primary">Cancel</a>
                    <br /><br />
                </div>
            </form>
        </section>

        <!-- Display the page footer -->
        <partial name="_BogFooterView" />

    </body>
</html>
