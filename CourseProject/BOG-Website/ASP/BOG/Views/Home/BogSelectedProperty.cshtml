@model PropertyT

@{
    Layout = null;

    var currDate = DateTime.Now.ToString("yyyy-MM-dd");
    var reviews = ViewData["Reviews"] as List<CommentsT>;
    var userId = TempData["userId"];

    ViewData["PageTitle"] = $"BeOurGuest - Current Properties";
    ViewData["ReturnAction"] = "BogSelectedProperty";

    string image = (String.IsNullOrEmpty(Model.ImageName) ? "Default-House.jpg" : Model.ImageName);
}

<!DOCTYPE html>

<html>
    <partial name="_BogHeaderView" />
    <body>

        <!-- Banner -->
        <section id="bannerList">
            <h2>Property @Model.PropertyIdPk Details</h2>
            <!--<form asp-action="BogReservationPage" method="post"> -->

            <form>
                @if (Context.User.Identity.IsAuthenticated && Context.User.IsInRole("User"))
                {
                    <a asp-action="BogStartReservation"
                       asp-route-propId="@Model.PropertyIdPk"
                       class="btn btn-sm btn-success">Reserve</a>
                }
                @if (Context.User.Identity.IsAuthenticated && Context.User.IsInRole("Admin"))
                {
                    <a asp-action="BogDelProperty"
                       asp-route-propId="@Model.PropertyIdPk"
                       class="btn btn-sm btn-warning">Delete</a>
                }
                <a asp-action="BogViewReservationsByPropId"
                   asp-route-propId="@Model.PropertyIdPk"
                   class="btn btn-sm btn-primary">View Reservations</a>

                <a asp-action="BogProperties" class="btn btn-sm btn-info">Cancel</a>
            </form>
        </section>

        <section id="secondbannerList">
                <ul class="article-list-vertical-Select">
                    <li>
                        <br />
                        <h1>@Model.PropertyTitle</h1>
                        <br />
                        <hr />
                        <p>
                            Property ID:&nbsp; @Model.PropertyIdPk
                            <br />Property Type:&nbsp; @Model.PropertyTypeIdFkNavigation.PropertyTypeName
                            <br />Location:&nbsp; @Model.Address &nbsp; @Model.City &nbsp; @Model.State &nbsp; @Model.Zipcode
                            <br />
                            <br />Number of Bedrooms:&nbsp; @Model.NumBedrooms
                            <br />Number of Bathrooms:&nbsp; @Model.NumBathrooms
                            <br />Square Footage:&nbsp; @Model.SqFt
                            <br />Guest Count: &nbsp; @Model.GuestCnt
                            <br />Daily Price: &nbsp; @Model.DailyPrice.ToString("c")

                            <img src="~/images/@image" alt="Property @Model.PropertyIdPk Specs" />

                            <br />Description:&nbsp; @Model.Description
                            <br />
                        </p>
                        <hr />

                        @if (Context.User.Identity.IsAuthenticated)
                        {
                            <!---------------SUBMIT COMMENT---------------------->
                            <h1>Add a Review</h1>
                            <br /><br />

                            <form asp-action="BogAddPropertyReview" 
                                  asp-route-userId="userId" 
                                  asp-route-propId="propId" 
                                  asp-route-rating="rating" 
                                  asp-route-myVisit="myVisit" 
                                  asp-route-comments="comments" 
                                  method="get">
                                <input type="hidden" name="propId" value="@Model.PropertyIdPk" />
                                <input type="hidden" name="userId" value="@userId"/>

                                <label for="rating">Rating:</label>
                                <select name="rating" required>
                                    <option value="5">5 - Very Satisfied</option>
                                    <option value="4">4 - Satisfied</option>
                                    <option value="3">3 - Fair</option>
                                    <option value="2">2 - Dissatisfied</option>
                                    <option value="1">1 - Very Dissatisfied</option>
                                </select>
                                <br />
                                <br />
                                <label for="myVisit">Date Visited:</label>
                                <input type="date" name="myVisit" required
                                       min="1900-01-01" max="@currDate" />
                                <br />
                                <br />
                                <label for="comments">Comments: </label>
                                <br />
                                <textarea rows="5" cols="50"
                                          name="comments"
                                          placeholder="Enter review comments here..."></textarea>
                                <br /><br />
                                <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                                <hr>
                            </form>
                            <br />
                        }

                        <!-----REVIEWS POPULATED FROM DB------->
                        <h1>Property Reviews</h1><br />
                        <p>
                            <table id="propertyReviews">
                                <thead>
                                    <tr>
                                        <th style="width:25%">Date Submitted</th>
                                        <th style="width:10%">Rating</th>
                                        <th style="width:20%">Date of Visit</th>
                                        <th style="width:55%">Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in reviews)
                                    {
                                        <tr>
                                            <td>@r.DateSubmitted.Date.ToString("MM/dd/yyyy")</td>
                                            <td>@r.Rating</td>
                                            <td>@(r.MonthYearVisit.HasValue ? r.MonthYearVisit.Value.ToString("MM/yyyy") : null)</td>
                                            <td>@r.Comments</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </p>
                    </li>
                </ul>
        </section>

        <!-- Display the page footer -->
        <partial name="_BogFooterView" />

    </body>
</html>
