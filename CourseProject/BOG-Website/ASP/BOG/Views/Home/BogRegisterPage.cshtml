@model UserT

@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Registstration Page";

    string confPassword = (string)ViewData["BogConfPassword"];
}

<!DOCTYPE html>

<html>
<partial name="_BogHeaderView" />
<body>

    <section id="bannerList">
        <h2>Register</h2>
    </section>

    @if (TempData["warning"] != null)
    {
        <div class="alert alert-warning">@TempData["warning"]</div>
    }

    <section id="bannerRegister">
        <form asp-action="BogRegisterValidate" method='post'>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="usercontainer">
                <label asp-for="Email">Email:</label>
                <input asp-for="Email" size="30" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <label asp-for="Password">Password:</label>
                <input asp-for="Password" size="20" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <label asp-for="FirstName">First Name:</label>
                <input asp-for="FirstName" size="30" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

                <label asp-for="LastName">Last Name:</label>
                <input asp-for="LastName" size="30" />
                <span asp-validation-for="LastName" class="text-danger"></span>

                <partial name="_BogUserAddressView" model="@Model" />

                <label asp-for="PhoneNumber">Phone Number:</label>
                <input asp-for="PhoneNumber" size="10" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                <div>
                    <hr />
                    <a asp-action="BogRegisterValidate" class="btn btn-sm btn-success" formmethod="post">Create Account</a>
                    <a asp-action="BogHome" class="btn btn-sm btn-info">Cancel</a>
                </div>
            </div>
        </form>
    </section>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }

</body>
</html>