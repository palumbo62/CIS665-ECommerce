@model UserT

@{
    Layout = null;
    ViewData["PageTitle"] = "BeOurGuest - Registration Page";

    string confPassword = (string)ViewData["BogConfPassword"];
}

<!DOCTYPE html>

<html>
<partial name="_BogHeaderView" />
<body>

    <section id="bannerList">
        <h2>Enter required account information</h2>
    </section>

    <section id="banner" style="padding: 5em 0 5em">
        <form asp-action="BogRegisterValidate">
            <div class="containerAddProp">
                <p>
                    <label class="BogLabel" asp-for="Email">Email Address</label>
                    <input class="BogInput" type="text" asp-for="Email" required autofocus
                           maxlength="50"
                           size="50"
                           pattern="^[a-zA-Z0-9._]+@@[a-z0-9.-]+\.[a-z]{3,50}$"
                           title="Enter email address, e.g. johndoe@email.com (max 50 chars)">
                </p>

                <!----- Password ------------------------------------------------------->

                <p>
                    <label class="BogLabel" asp-for="Password">Password</label>
                    <input class="BogInput" type="password" asp-for="Password" required
                           pattern="^[a-zA-Z0-9 .!$]{4,20}$"
                           maxlength="20"
                           size="20"
                           title="Must be 4-20 in length using alpha-numeric and the set of [ !.$] characters" />
                </p>

                <p>
                    <label class="BogLabel" for="confPassword">Confirmation Password</label>
                    <input class="BogInput" type="password" for="confPassword" 
                           pattern="^[a-zA-Z0-9 .!$]{4,20}$"
                           maxlength="20"
                           size="20"
                           title="Must match password" />
                </p>

                <p>
                    <label class="BogLabel" asp-for="FirstName">First Name</label>
                    <input class="BogInput" type="text" asp-for="FirstName" required
                           maxlength="30"
                           size="30"
                           pattern="^[a-zA-Z ']{1,30}$"
                           title="Enter first name">
                </p>

                <!----- Last Name ------------------------------------------------------>
                <p>
                    <label class="BogLabel" asp-for="LastName">Last Name</label>
                    <input class="BogInput" type="text" asp-for="LastName" required
                           maxlength="30"
                           size="30"
                           pattern="^[a-zA-Z ']{1,30}$"
                           title="Enter last name">
                </p>

                <partial name="_BogUserAddressView" model="@Model" />

                <p>
                    <label class="BogLabel" asp-for="PhoneNumber">Phone Number</label>
                    <input class="BogInput" type="text" asp-for="PhoneNumber" required
                           maxlength="10"
                           size="10"
                           pattern="^[0-9]{10}$"
                           title="Enter 10-digit phone number">
                </p>

                <p>
                    <label class="BogLabel" asp-for="RoleIdFk">User Account</label>
                    <input id="BogRadio" type="radio" asp-for="RoleIdFk" value="2" checked />
                </p>

                <p>
                    <label class="BogLabel" asp-for="RoleIdFk">Admin Account</label>
                    <input id="BogRadio" type="radio" asp-for="RoleIdFk" value="1" />
                </p>

                <hr />
                <button class="btn btn-sm btn-success" type="submit">Create Account</button>
                <a asp-action="BogHome" class="btn btn-sm btn-info">Cancel</a>
            </div>
        </form>
    </section>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />

</body>
</html>