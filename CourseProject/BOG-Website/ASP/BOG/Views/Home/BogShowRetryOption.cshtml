
@{
    Layout = null;
    var msg = ViewBag.BogErrMsg;
    var retryPage = ViewBag.BogRetryPage;
}

<!DOCTYPE html>

<html>
<body>
    <partial name="_BogHeaderView" />

    @*Razor block example*@
    <section id="bannerList">
        <h3 class="alert-heading">@msg</h3>

        <br /><br />
        <a class="btn btn-sm btn-warning" asp-action="@retryPage">Retry?</a>
        <a class="btn btn-sm btn-info" asp-action="BogHome">Home Page</a>
        <br />
        <br />
        <br />
    </section>

    <!-- Display the page footer -->
    <partial name="_BogFooterView" />
</body>
</html>
