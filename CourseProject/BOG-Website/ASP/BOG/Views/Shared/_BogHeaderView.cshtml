@{
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor

    var userId = TempData["UserId"];
    var xUserId = TempData["UserId"];
}

<head>
    <meta name="viewport" content="width=device-width" />

    <title>BeOurGuest - Vacation Rentals</title>
    <link href="~/css/BOG_Style_Layout_All.RLP.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
</head>

<div>
    <header id="header">
        <h1>
            @ViewData["PageTitle"]
        </h1>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <ul class="navbar-brand">
                <li class="nav-item">
                    <a asp-action="index">Home</a>
                </li>
                <li class="nav-item" style="text-decoration:none">
                    <a asp-action="BogProperties">Properties</a>
                </li>
                @if (!Context.User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a asp-action="BogLoginPage">Login/Register</a>
                    </li>
                }
                else
                {
                    if (Context.User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a asp-action="#" style="max-height: 40px" dropdown-toggle" id="navbarDropdown"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Admin</a>
                            <div style="max-height: 40px" class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <a style="max-height: 40px" asp-action="BogAddProperty" 
                                    class="dropdown-link" formmethod="get" >Add Property</a>
                                <a style="max-height: 40px" asp-action="BogDelProperty" 
                                    class="dropdown-item" formmethod="get" >Delete Property</a>
                            </div>
                        </li>

                        @*<li>
                    <div class="dropdown">
                        <button class="dropbtn">Admin<i class="fa fa-caret-down"></i></button>
                        <div class="dropdown-content">
                            <a asp-action="BogAddProperty" class="dropdown-item">Add Property</a>
                            <a asp-action="BogDelProperty" class="dropdown-item">Delete Property</a>
                        </div>
                    </div>
                </li>*@
                    }
                    else if (Context.User.IsInRole("User"))
                    {
                        // Registered User
                        <li class="nav-item">
                            <a asp-action="BogUserProfile" asp-route-userId="@TempData["UserId"]">Account</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a asp-action="BogLogout">Logout</a>
                    </li>
                }
                <li class="nav-item">
                    <a asp-action="BogAbout">About</a>
                </li>
            </ul>
        </nav>
    </header>
</div>
