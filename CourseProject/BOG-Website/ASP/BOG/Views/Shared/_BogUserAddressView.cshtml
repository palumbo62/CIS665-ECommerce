<!----- ZIP Code ------------------------------------------------------->
<p>
    <label asp-for="Zipcode">Zipcode:</label>
    <input type="text" asp-for="Zipcode" required
           autofocus
           maxlength="5"
           size="5"
           pattern="^[0-9]{5}$"
           title="Enter 5-digit zipcode">
</p>

