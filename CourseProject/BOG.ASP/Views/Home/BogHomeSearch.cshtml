@model BogHomeSearch;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bog Home Search</title>
</head>
<body style="font-size: large">
    <h1>Search for Poperties</h1>

    @*Razor block example*@

    <p>

        @*Embedded C#*@
        @if (true)
        {
            @: @Model.propertyType
            @: @Model.city
            @: @Model.state
            @: @Model.zipcode
        }
        
        
        @*Asp-action to show a new View*@

        <br /><br />
        Click <a asp-action="BogHome">here</a> to return to the Home Page.

    </p>

</body>
</html>
