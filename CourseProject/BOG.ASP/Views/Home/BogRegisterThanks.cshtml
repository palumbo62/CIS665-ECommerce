@model BogUserProfile;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thanks</title>
</head>
<body style="font-size: large">
    <h1>Thank you, @Model.firstName</h1>

    @*Razor block example*@

    <p>

        @*Embedded C#*@
        @if (true)
        {
            @: @Model.firstName
            @: @Model.lastName
            @: @Model.address
            @: @Model.city
            @: @Model.state
            @: @Model.zipcode
            @: @Model.roletype
        }
        
        
        @*Asp-action to show a new View*@

        <br /><br />
        Click <a asp-action="Register">here</a> to add another user.

    </p>

</body>
</html>
