    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
<head>
    <meta name="viewport" content="width=device-width" />
    <title>BeOurGuest - Vacation Rentals</title>
    <link rel="stylesheet" type="text/css" href="~/css/BOG_Style_Layout_All.css">
    <link rel="stylesheet" href="../fonts/css/font-awesome.css">
</head>

<div>
    <!-- Header -->
    <header id="header">
        <h1>
            @ViewBag.PageTitle
        </h1>
        <nav id="nav">
            <ul>
                <li>
                    <a class="btn btn-primary" asp-action="index">Home</a>
                </li>
                <li>
                    <a class="btn btn-primary" asp-action="BogProperties">Properties</a>
                </li>

                @if (ViewBag.UserLoggedIn == true)
                {
                    if (ViewBag.UserRoleType == 1)
                    {
                        // Admin
                        <li>
                            <div class="dropdown">
                                <button class="dropbtn">Admin<i class="fa fa-caret-down"></i></button>
                                <div class="dropdown-content">
                                    <a class="btn btn-primary" asp-action="BogAddProperty">Add Property</a>
                                    <a class="btn btn-primary" asp-action="BogDelProperty">Delete Property</a>
                                </div>
                            </div>
                        </li>
                    }
                    else if (ViewBag.UserRoleType == 2)
                    {
                        // Registered User
                        <li>
                            <a class="btn btn-primary" asp-action="BogUserProfile">Account</a>
                        </li>
                    }

                    <li>
                        <a class="btn btn-primary" asp-action="BogLogout">Logout</a>
                    </li>
                }
                else
                {
                    <li>
                        <a class="btn btn-primary" asp-action="BogLoginPage">Login/Register</a>
                    </li>
                }

                <li>
                    <a class="btn btn-primary" asp-action="BogAbout">About</a>
                </li>

            </ul>
        </nav>
    </header>
</div>
